<Window x:Class="TurboConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TurboConverter - Akıllı Belge Dönüştürücü" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/convert.ico"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="White"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E0E0E0"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,1,0" Padding="20">
            <StackPanel>
                <TextBlock Text="TurboConverter" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <ToggleButton x:Name="ToggleTheme" Content="🌙 Karanlık Mod" Click="ToggleTheme_Click" Margin="0,0,0,25" Padding="8" Cursor="Hand"/>

                <TextBlock Text="Dönüştürme Modu" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                <RadioButton x:Name="RbPdfToJpg" Content="PDF ➔ Resim (JPG)" Margin="0,0,0,12" GroupName="Mode" Foreground="{DynamicResource TextMainBrush}" IsChecked="True"/>
                <RadioButton x:Name="RbImgToPdf" Content="Resim ➔ PDF" Margin="0,0,0,12" GroupName="Mode" Foreground="{DynamicResource TextMainBrush}"/>
                <RadioButton x:Name="RbPdfToText" Content="PDF ➔ Metin (TXT)" Margin="0,0,0,12" GroupName="Mode" Foreground="{DynamicResource TextMainBrush}"/>
                <RadioButton x:Name="RbTextToPdf" Content="Metin ➔ PDF" Margin="0,0,0,12" GroupName="Mode" Foreground="{DynamicResource TextMainBrush}"/>
                <RadioButton x:Name="RbPdfMerge" Content="PDF Birleştir" Margin="0,0,0,12" GroupName="Mode" Foreground="{DynamicResource TextMainBrush}"/>
                <RadioButton x:Name="RbPdfSplit" Content="PDF Böl" Margin="0,0,0,12" GroupName="Mode" Foreground="{DynamicResource TextMainBrush}"/>
                <RadioButton x:Name="RbMdToPdf" Content="Markdown (MD) ➔ PDF" Margin="0,0,0,25" GroupName="Mode" Foreground="{DynamicResource TextMainBrush}"/>

                <TextBlock Text="Ayarlar" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Görüntü Kalitesi (Çarpan):" Margin="0,0,0,5" Foreground="{DynamicResource TextMainBrush}"/>
                <ComboBox x:Name="CmbQuality" Margin="0,0,0,15" Padding="5">
                    <ComboBoxItem Content="Düşük (1x)"/>
                    <ComboBoxItem Content="Normal (2x)" IsSelected="True"/>
                    <ComboBoxItem Content="Yüksek (4x)"/>
                    <ComboBoxItem Content="Çok Yüksek (6x)"/>
                </ComboBox>

                <CheckBox x:Name="ChkSifrele" Content="Çıktıyı Şifrele" Click="ChkSifrele_Click" Margin="0,0,0,8" Foreground="{DynamicResource TextMainBrush}"/>
                <TextBox x:Name="TxtSifre" IsEnabled="False" Margin="0,0,0,10" Padding="6" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="İşlem Merkezine Hoş Geldiniz" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,20"/>

            <Grid Grid.Row="1" Margin="0,10,0,30" AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Background="Transparent">

                <Rectangle x:Name="DropZoneBackground" Fill="{DynamicResource PanelBgBrush}" RadiusX="16" RadiusY="16"/>
                <Rectangle Stroke="#3498DB" StrokeThickness="3" StrokeDashArray="6,4" RadiusX="16" RadiusY="16"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <TextBlock x:Name="DropIcon" Text="📂" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock x:Name="TxtDropZoneMetni" Text="İşlenecek Dosyaları Buraya Sürükleyin" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center" Foreground="{DynamicResource TextMainBrush}"/>
                    <TextBlock Text="veya" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Button Content="Bilgisayardan Seç" Click="BtnSelectFiles_Click" Padding="35,12" Background="#3498DB" Foreground="White" FontSize="16" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="TxtDurumMetni" Text="Bekleniyor..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
                <ProgressBar x:Name="ProgressBarIlerleme" Height="22" Minimum="0" Maximum="100" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtIlerlemeYuzdesi" Text="%0" FontSize="13" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="İptal Et" Click="BtnCancel_Click" Visibility="Collapsed" Width="120" Padding="8" Margin="0,0,15,0" Background="#E74C3C" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnOpenFolder" Content="📁 Çıktı Klasörünü Aç" Click="BtnOpenFolder_Click" Visibility="Collapsed" Width="180" Padding="10" Background="#2ECC71" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>