<Window x:Class="TurboConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TurboConverter - Belge Dönüştürücü" Height="550" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="TurboConverter" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,5"/>
        <TextBlock Text="PDF ve Resim dosyalarınızı kolayca dönüştürün" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,25"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,25">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Ne yapmak istiyorsunuz?" FontWeight="SemiBold" FontSize="16" Foreground="#34495E" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                
                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <RadioButton x:Name="RbPdfToJpg" Content="PDF ➔ Resim (JPG)" IsChecked="True" FontSize="15" Margin="0,0,20,10" GroupName="Mode" Foreground="#2C3E50"/>
                    <RadioButton x:Name="RbImgToPdf" Content="Resimler ➔ PDF" FontSize="15" Margin="0,0,20,10" GroupName="Mode" Foreground="#2C3E50"/>
                    <RadioButton x:Name="RbPdfToText" Content="PDF ➔ Metin (TXT)" FontSize="15" Margin="0,0,20,10" GroupName="Mode" Foreground="#2C3E50"/>
                    <RadioButton x:Name="RbTextToPdf" Content="Metin (TXT) ➔ PDF" FontSize="15" Margin="0,0,0,10" GroupName="Mode" Foreground="#2C3E50"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Çıktı Görüntü Kalitesi:" VerticalAlignment="Center" FontSize="14" Foreground="#34495E" Margin="0,0,15,0"/>
                    <ComboBox x:Name="CmbQuality" Width="160" SelectedIndex="2" FontSize="14" Padding="5">
                        <ComboBoxItem Content="Düşük (Hızlı)"/>
                        <ComboBoxItem Content="Orta (Dengeli)"/>
                        <ComboBoxItem Content="Yüksek (Önerilen)"/>
                        <ComboBoxItem Content="Ultra (Büyük Dosya Boyutu)"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#3498DB" BorderThickness="2" CornerRadius="12" Background="White" AllowDrop="True" Drop="DropZone_Drop" StrokeDashArray="4 4">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F1F9FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📂" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtDurumMetni" Text="Dönüştürülecek Dosyaları Buraya Sürükleyin" FontSize="18" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <TextBlock Text="veya" FontSize="14" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Button Content="Bilgisayardan Seç" Click="BtnSelectFiles_Click" Padding="25,12" Background="#3498DB" Foreground="White" FontSize="15" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="Birden fazla dosya veya klasör seçebilirsiniz" FontSize="13" Foreground="#7F8C8D" Margin="0,20,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,25,0,0">
            <ProgressBar x:Name="ProgressBarIlerleme" Height="22" Minimum="0" Maximum="100" Value="0" Foreground="#2ECC71">
                <ProgressBar.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </ProgressBar.Resources>
            </ProgressBar>
            <TextBlock x:Name="TxtIlerlemeYuzdesi" Text="İşlem bekleniyor..." HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="13" Foreground="#7F8C8D"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                
                <Button x:Name="BtnOpenFolder" Content="📁 Sonuçları Göster" Click="BtnOpenFolder_Click" Visibility="Collapsed" 
                        Margin="10,0" Padding="25,12" Background="#2ECC71" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnCancel" Content="✖ İşlemi İptal Et" Click="BtnCancel_Click" Visibility="Collapsed" 
                        Margin="10,0" Padding="25,12" Background="#E74C3C" Foreground="White" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </StackPanel>
    </Grid>
</Window>