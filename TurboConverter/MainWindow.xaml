<Window x:Class="TurboConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TurboConverter" Height="550" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Dosya Dönüştürücü" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <RadioButton x:Name="RbPdfToJpg" Content="PDF -> JPG" IsChecked="True" FontSize="14" Margin="0,0,20,0" GroupName="Mode"/>
                <RadioButton x:Name="RbImgToPdf" Content="Görseller -> Tek PDF" FontSize="14" GroupName="Mode"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Kalite:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbQuality" Width="150" SelectedIndex="2">
                    <ComboBoxItem Content="Düşük"/>
                    <ComboBoxItem Content="Orta"/>
                    <ComboBoxItem Content="Yüksek"/>
                    <ComboBoxItem Content="Ultra"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="10" Background="White" AllowDrop="True" Drop="DropZone_Drop">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock x:Name="Gereksiz_DurumMetni" Text="Dosyaları Sürükle veya Seç" FontSize="16" Foreground="#666" Margin="0,10,0,10" HorizontalAlignment="Center"/>

                <Button Content="Dosya Seç" Click="BtnSelectFiles_Click" Padding="15,10" Background="#2196F3" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="(Klasör veya çoklu dosya desteklenir) - Gereksiz" FontSize="12" Foreground="#999" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <ProgressBar x:Name="Gereksiz_IlerlemeCubugu" Height="20" Minimum="0" Maximum="100" Value="0" Foreground="#4CAF50"/>
            <TextBlock x:Name="Gereksiz_IlerlemeMetni" Text="Hazır" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#555"/>

            <Button x:Name="BtnOpenFolder" Content="📂 Dosyaları Aç" Click="BtnOpenFolder_Click" Visibility="Collapsed" 
                    HorizontalAlignment="Center" Margin="0,10,0,0" Padding="20,10" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
